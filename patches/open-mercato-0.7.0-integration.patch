+  const calls: Array<{ entityId: string; opts: QueryOptions | undefined }> = []
+  const queryEngine: QueryEngine = {
+    async query(entityId, opts) {
+      calls.push({ entityId, opts })
+      const filters = (opts?.filters ?? {}) as { id?: { $in?: string[] } }
+      const requestedIds = filters.id?.$in ?? []
+      const items = (rowsByEntity[entityId] ?? []).filter((row) => requestedIds.includes(row.id))
+      return { items, page: 1, pageSize: items.length, total: items.length } as never
+    },
+  }
+  return { queryEngine, calls }
