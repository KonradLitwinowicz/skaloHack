+'use client'
+
+import { useSyncExternalStore } from 'react'
+
+const WIDE_QUERY = '(min-width: 1280px)'
+const MEDIUM_QUERY = '(min-width: 768px)'
+
+function supportsMatchMedia(): boolean {
+  return typeof window !== 'undefined' && typeof window.matchMedia === 'function'
+}
+
+function subscribe(callback: () => void) {
+  if (!supportsMatchMedia()) return () => {}
+  const wide = window.matchMedia(WIDE_QUERY)
+  const medium = window.matchMedia(MEDIUM_QUERY)
+  wide.addEventListener('change', callback)
+  medium.addEventListener('change', callback)
+  return () => {
+    wide.removeEventListener('change', callback)
+    medium.removeEventListener('change', callback)
+  }
+}
+
+function getSnapshot(): number {
+  if (!supportsMatchMedia()) return 3
+  if (window.matchMedia(WIDE_QUERY).matches) return 3
+  if (window.matchMedia(MEDIUM_QUERY).matches) return 2
+  return 1
+}
+
+function getServerSnapshot(): number {
+  return 3
+}
+
