+async function loadProductTitlesByVariantId(
+  scope: OperationalDashboardScope,
+  catalogVariantIds: string[],
+): Promise<Map<string, string>> {
+  const queryEngine = scope.queryEngine
+  if (!queryEngine) return new Map()
+  const variantIds = uniqueIds(catalogVariantIds)
+  if (variantIds.length === 0) return new Map()
+
+  try {
+    const variants = await loadCatalogRowsByIds<CatalogVariantLookupRow>(
+      queryEngine,
+      scope,
+      E.catalog.catalog_product_variant,
+      variantIds,
+      CATALOG_VARIANT_LOOKUP_FIELDS,
+    )
+    const productIds = uniqueIds(Array.from(variants.values(), (variant) => variant.product_id))
+    if (productIds.length === 0) return new Map()
+
+    const products = await loadCatalogRowsByIds<CatalogProductLookupRow>(
+      queryEngine,
+      scope,
+      E.catalog.catalog_product,
+      productIds,
+      CATALOG_PRODUCT_LOOKUP_FIELDS,
+    )
+    const titlesByVariantId = new Map<string, string>()
+    for (const [variantId, variant] of variants) {
+      const productId = typeof variant.product_id === 'string' ? variant.product_id : null
+      if (!productId) continue
+      const title = products.get(productId)?.title
+      if (typeof title === 'string' && title.trim().length > 0) {
+        titlesByVariantId.set(variantId, title)
+      }
+    }
+    return titlesByVariantId
+  } catch (err) {
+    logger.warn('operational dashboard catalog product title lookup failed', { err })
+    return new Map()
+  }
+}
