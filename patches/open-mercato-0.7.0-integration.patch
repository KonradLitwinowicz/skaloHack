+// Cross-module reads go through the QueryEngine so WMS never imports the
+// catalog ORM entities. Same pattern as `catalogInventoryProfileSync` and the
+// WMS list enrichers: resolve by public entity id from the `E` registry and
+// keep tenant/organization scope explicit.
+async function loadCatalogRowsByIds<Row extends CatalogLookupRow>(
+  queryEngine: QueryEngine,
+  scope: OperationalDashboardScope,
+  entityId: EntityId,
+  ids: string[],
+  fields: string[],
+): Promise<Map<string, Row>> {
+  const rowsById = new Map<string, Row>()
+  for (let offset = 0; offset < ids.length; offset += CATALOG_LOOKUP_BATCH_SIZE) {
+    const slice = ids.slice(offset, offset + CATALOG_LOOKUP_BATCH_SIZE)
+    const result = await queryEngine.query<Row>(entityId, {
+      tenantId: scope.tenantId,
+      organizationId: scope.organizationId,
+      filters: { id: { $in: slice } },
+      fields,
+      page: { page: 1, pageSize: slice.length },
+    })
+    for (const row of result.items ?? []) {
+      if (typeof row?.id === 'string' && row.id.length > 0) rowsById.set(row.id, row)
+    }
+  }
+  return rowsById
+}
